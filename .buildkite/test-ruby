#!/usr/bin/env bash
set -euo pipefail

# Separate Compose projects keep parallel jobs' databases and cleanup isolated.
export COMPOSE_PROJECT_NAME="ci-${BUILDKITE_JOB_ID:-local-$$}"
export CI_UID="$(id -u)" CI_GID="$(id -g)"
# Create bind-mount sources as the agent, not as the root-owned Docker daemon.
mkdir -p test/reports tmp/screenshots
compose=(docker compose -f docker-compose.ci.yml)
trap '"${compose[@]}" down --volumes --remove-orphans' EXIT

"${compose[@]}" build web
"${compose[@]}" up -d --wait db

if [[ "$*" == "bin/rails test" ]]; then
  "${compose[@]}" run --rm --no-deps web bin/rubocop
  export JUNIT_OUTPUT=/rails/test/reports/ruby
else
  export JUNIT_OUTPUT=/rails/test/reports/browser
fi

"${compose[@]}" run --rm web bin/rails db:prepare
"${compose[@]}" run --rm web "$@"
