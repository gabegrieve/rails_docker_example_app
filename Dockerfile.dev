# syntax=docker/dockerfile:1
# Development Dockerfile for use with docker-compose.
# The production Dockerfile lives alongside this one (see ./Dockerfile).

ARG RUBY_VERSION=3.4.9
FROM docker.io/library/ruby:$RUBY_VERSION-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      chromium \
      chromium-driver \
      curl \
      git \
      libpq-dev \
      libvips \
      libyaml-dev \
      pkg-config \
      postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Point the system tests at the distro-installed Chromium + matching driver so
# Selenium Manager doesn't try to download a (mismatched) chromedriver.
ENV CHROME_BIN="/usr/bin/chromium" \
    CHROMEDRIVER_BIN="/usr/bin/chromedriver"

WORKDIR /rails

COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

EXPOSE 4000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
